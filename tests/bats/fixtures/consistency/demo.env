# Names and settings for the demo. Make includes this file and scripts source it.
# Format: KEY=value, no quotes, no spaces, no variable references (valid for both make and bash).
# Pins live in versions.env. Secrets live in .env (never committed).

# --- cluster ---
CLUSTER_NAME=argoconna26
CLUSTER_CONTEXT=kind-argoconna26
KUBECONFIG_REL=.kube/argoconna26.yaml

# --- tools (P25): pinned tools must win on PATH ---
TOOLS_BIN=/home/linuxbrew/.linuxbrew/bin

# --- namespaces ---
NS_ARGOCD=argocd
NS_ROLLOUTS=argo-rollouts
NS_MONITORING=monitoring
NS_DEMO=demo
NS_AIOPS=aiops

# --- host ports (127.0.0.1 only; each equals its NodePort) ---
HOST_BIND=127.0.0.1
PORT_ARGOCD=30080
PORT_GRAFANA=30030
PORT_PROMETHEUS=30090
PORT_BRIDGE=30081
PORT_SIM=30082
PORT_LITELLM=30400
ARGOCD_HOST_URL=http://127.0.0.1:30080
GRAFANA_HOST_URL=http://127.0.0.1:30030
PROM_HOST_URL=http://127.0.0.1:30090

# --- in-cluster URLs ---
CHECKOUT_URL=http://checkout.demo.svc:8080
PRICING_URL=http://pricing.demo.svc:8080
BRIDGE_URL=http://bridge.aiops.svc:8080
SIM_URL=http://cdevents-sim.aiops.svc:8080
LITELLM_URL=http://litellm.aiops.svc:4000/v1
PROM_URL=http://kps-prometheus.monitoring.svc:9090

# --- Helm release names ---
ARGOCD_RELEASE=argocd
ROLLOUTS_RELEASE=argo-rollouts
KPS_RELEASE=kps
ARGO_HELM_REPO=https://argoproj.github.io/argo-helm
PROM_HELM_REPO=https://prometheus-community.github.io/helm-charts

# --- golden-path labels and the config annotation ---
LABEL_OWNER_KEY=example.dev/owner
LABEL_OWNER_VALUE=payments-team
LABEL_TIER_KEY=example.dev/tier
LABEL_TIER_VALUE=1
LABEL_SLO_KEY=slo.example.dev/success-rate
LABEL_SLO_VALUE=99
CONFIG_VERSION_ANNOTATION=example.dev/config-version
CONFIG_VERSION_START=7

# --- checkout config ---
CHECKOUT_POD_SELECTOR=app=checkout
CONFIG_MAP=checkout-config
CONFIG_KEY=UPSTREAM_TIMEOUT_MS
CONFIG_HEALTHY=2000
CONFIG_ARMED=200
CONFIG_FILE=apps/checkout/config/checkout-config.yaml
ROLLOUT_FILE=apps/checkout/deploy/rollout.yaml
KUSTOMIZATION_FILE=apps/checkout/kustomization.yaml
CHECKOUT_STABLE_TAG=v1.4.1

# --- GitOps ---
TRACKED_BRANCH=build/demo
REPO_SLUG=argo-multiverse-labs/argoconna26
AUTONOMY_FILE=aiops/autonomy.yaml
OPERATOR_DIR=${HOME}/.local/share/argoconna26/operator

# --- GitHub identities and rulesets ---
BOT_LOGIN=argoconna26-agent[bot]
PROMOTION_TEAM=@argo-multiverse-labs/promotion-board
POLICY_CHECK_CONTEXT=policy-check
POLICY_CHECK_INTEGRATION_ID=15368
RULESET_BRANCHES=build/demo,main
RULESET_INTEGRITY=argoconna26-integrity
RULESET_TRACKED=argoconna26-tracked
RULESET_PROMOTE=argoconna26-promote

# --- AIOps ---
LLM_ALIAS_RCA=rca
LLM_ALIAS_JUDGE=judge
BRIDGE_EVENT_SOURCE=/argoconna26/bridge
HOLMES_TIMEOUT_S=115

# --- stage ---
STAGE_COLS=30
