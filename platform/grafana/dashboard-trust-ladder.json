{
  "uid": "trust-ladder",
  "title": "Trust ladder",
  "tags": [
    "argoconna26"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Checkout success rate against the SLO",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(checkout_requests_total{code!~\"5..\"}[30s])) / sum(rate(checkout_requests_total[30s]))",
          "legendFormat": "success rate",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(checkout_slo_target_percent)",
          "legendFormat": "SLO target",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "custom": {
            "lineWidth": 4,
            "fillOpacity": 8,
            "showPoints": "never",
            "axisLabel": "",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success rate"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "SLO target"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Delivery and agent events",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "cdevents-sim"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 14,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "cdevents-sim"
          },
          "type": "json",
          "parser": "backend",
          "format": "table",
          "source": "url",
          "url": "http://cdevents-sim.aiops.svc:8080/annotations?since=-72h&limit=12",
          "url_options": {
            "method": "GET",
            "data": ""
          },
          "root_selector": "$map($, function($r){ {\"time\": $r.time, \"type\": $r.title, \"app\": $r.tags[1], \"sha\": $r.commit, \"summary\": $r.text} })",
          "columns": [
            {
              "selector": "time",
              "text": "time",
              "type": "timestamp_epoch"
            },
            {
              "selector": "type",
              "text": "type",
              "type": "string"
            },
            {
              "selector": "app",
              "text": "app",
              "type": "string"
            },
            {
              "selector": "sha",
              "text": "commit",
              "type": "string"
            },
            {
              "selector": "summary",
              "text": "summary",
              "type": "string"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time: HH:mm"
              },
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "type"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 190
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic",
                  "applyToRow": true
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "transparent"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^incident\\.detected$",
                      "result": {
                        "color": "dark-red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^incident\\.resolved$",
                      "result": {
                        "color": "dark-green",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(agent|holmesgpt).*",
                      "result": {
                        "color": "dark-purple",
                        "index": 2
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^change\\..*",
                      "result": {
                        "color": "dark-blue",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "app"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "commit"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "lg",
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {},
            "indexByName": {
              "time": 0,
              "type": 1,
              "app": 2,
              "commit": 3,
              "summary": 4
            }
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "Steps a human must take at this autonomy level, not a speed race",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (level) (aiops_human_touchpoints)",
          "legendFormat": "{{level}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 3,
          "decimals": 0,
          "noValue": "pending",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "suggest"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "suggest: before merge"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "propose"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "propose: before merge"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "act"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "act: after the fact"
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "top",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 20,
          "valueSize": 40
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Trust metrics",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 11,
        "w": 10,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(aiops_dryrun_accuracy_ratio) or on() vector(-1)",
          "legendFormat": "dry-run accuracy",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aiops_fix_prs_total{outcome=\"merged\"}) or vector(0)",
          "legendFormat": "fix PRs merged",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aiops_fix_prs_total{outcome=\"rejected\"}) or vector(0)",
          "legendFormat": "fix PRs rejected by a human",
          "instant": false,
          "range": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aiops_guardrail_executions_total) or vector(0)",
          "legendFormat": "guardrail refusals",
          "instant": false,
          "range": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aiops_pii_leaks_caught_total) or vector(0)",
          "legendFormat": "PII leaks caught",
          "instant": false,
          "range": true
        },
        {
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(aiops_actions_total) or vector(0)",
          "legendFormat": "agent actions",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "pending"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dry-run accuracy"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {
          "titleSize": 20,
          "valueSize": 36
        }
      }
    }
  ]
}
